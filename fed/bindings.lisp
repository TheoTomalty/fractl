(define-editor-command operate-line
    (:cursor cursor :modes () :keys ((key *current-key*)) :n n :operator operator)
  ;; COMPAT: does not error when on last line and n > 1
  (macrolet ((expect (k)
               `(unless (eql key ,k)
                  (editor-error "~s is unbound" key))))
    (ecase (first operator)
      (apply-delete-operator (expect #\d))
      ((apply-change-operator apply-comment-operator) (expect #\c))
      (apply-downcase-operator (expect #\u))
      (apply-upcase-operator (expect #\U))
      (apply-format-operator (expect #\q))
      (apply-yank-operator (expect #\y))
      (apply-invcase-operator (expect #\~))
      (apply-increment-indent (expect #\>))
      (apply-decrement-indent (expect #\<))
      (apply-indent-operator (expect #\=))))
  (let* ((line (cursor-line cursor)))
    (select-lines (cursor-buffer cursor) line (1- (+ line n)))))
