(in-package "FED")


(defun point-forward-char (point &optional (n 1))
  (loop repeat n while (point-next point))
  point)

(defun point-backward-char (point &optional (n 1))
  (loop repeat n while (point-prev point))
  point)

(defun point-beginning-of-line (point &optional (n 1))
  (merge-point point (text-coord-point (point-text point) (coord 0 (max 0 (- (point-line point) (1- n)))))))

(defun point-back-to-indentation (point &optional (n 1))
  (point-forward-until-maybe (point-beginning-of-line point n)
                             #'point-not-at-space-p))

(defun point-end-of-line (point &optional (n 1))
  (merge-point point (text-coord-point (point-text point) (coord -1 (+ (point-line point) (1- n))))))

(defun char-syntax-type (char)
  (when char
    (cond ((or (char<= #\a char #\z) (char<= #\A char #\Z) (char<= #\0 char #\9))
           :word)
          ((member char '(#\Space #\Tab #\Return #\Newline))
           :whitespace)
          (t :symbol))))

(macrolet ((def (name (var1 var2) &body body)
             `(defun ,name (point)
                (let ((,var1 (char-syntax-type (point-peek-prev point)))
                      (,var2 (char-syntax-type (point-peek point))))
                  (or ,@body)))))
  (def point-at-begin-word-p (t1 t2)
    (and (not (eql :word t1)) (eql :word t2))
    (and (not (eql :symbol t1)) (eql :symbol t2)))
  (def point-at-end-word-p (t1 t2)
    (and (eql :word t1) (not (eql :word t2)))
    (and (eql :symbol t1) (not (eql :symbol t2))))
  (def point-at-begin-word-full-p (t1 t2)
    (and (eql :whitespace t1) (not (eql :whitespace t2))))
  (def point-at-end-word-full-p (t1 t2)
    (and (not (eql :whitespace t1)) (eql :whitespace t2)))
  (def point-at-begin-identifier-p (t1 t2)
    (and (not (eql :word t1)) (eql :word t2)))
  (def point-at-end-identifier-p (t1 t2)
    (and (eql :word t1) (not (eql :word t2)))))

(defun point-forward-until (point predicate &aux eob)
  (loop until (or (setf eob (null (point-next point)))
                  (funcall predicate point)))
  (values point eob))

(defun point-backward-until (point predicate &aux bob)
  (loop until (or (setf bob (null (point-prev point)))
                  (funcall predicate point)))
  (values point bob))

(defun point-forward-until-maybe (point predicate)
  (unless (funcall predicate point)
    (point-forward-until point predicate))
  point)

(defun point-backward-until-maybe (point predicate)
  (unless (funcall predicate point)
    (point-backward-until point predicate))
  point)

(defun point-not-at-space-p (point)
  (not (char-space-p (point-peek point))))

(defun point-not-at-space-prev-p (point)
  (not (char-space-p (point-peek-prev point))))

(defun point-empty-line-p (point)
  (setf point (copy-point point))
  (point-beginning-of-line point)
  (loop until (point-eol-p point) always (char-space-p (point-next point))))

(defun point-forward-paragraph (point &key (n 1))
  (loop named outer repeat n
        do (loop with nonempty-p = (not (point-empty-line-p point))
                 do (point-end-of-line point 2)
                    (when (point-eob-p point)
                      (return-from outer)) 
                    (if (point-empty-line-p point)
                        (when nonempty-p
                          (progn (point-beginning-of-line point) (return)))
                        (setf nonempty-p t))))
  point)

(defun point-backward-paragraph (point &key (n 1))
  (loop named outer repeat n
        do (loop with nonempty-p = (not (point-empty-line-p point))
                 do (point-beginning-of-line point 2)
                    (when (point-bob-p point)
                      (return-from outer))
                    (if (point-empty-line-p point)
                        (when nonempty-p (return))
                        (setf nonempty-p t))))
  point)

(defun point-skip-prev-if-newline (point)
  (if (eql #\Newline (point-peek-prev point))
      (point-skip-prev point)
      point))

(defun point-select-paragraph (point)
  (let ((left (point-beginning-of-line (copy-point point)))
        (right (point-end-of-line (copy-point point)))
        (empty-p (point-empty-line-p point)))
    (loop while (point-peek-prev left)
          do (point-beginning-of-line left 2)
             (unless (eql empty-p (point-empty-line-p left))
               (point-beginning-of-line left 0)
               (return)))
    (loop while (point-peek right)
          do (point-end-of-line right 2)
             (unless (eql empty-p (point-empty-line-p right))
               (point-end-of-line right 0)
               (return)))
    (values left right)))

(defun point-select-paragraphs-down (point &key (n 1))
  (let ((left nil))
    (setf (values left point) (point-select-paragraph point))
    (loop repeat (1- n)
          do (unless (point-peek point)
               (return))
             (point-end-of-line point 2)
             (setf point (nth-value 1 (point-select-paragraph point))))
    (values :line left point)))

(defun point-select-paragraphs-up (point &key (n 1))
  (let ((right nil))
    (setf (values point right) (point-select-paragraph point))
    (loop repeat (1- n)
          do (unless (point-peek-prev point)
               (return))
             (point-beginning-of-line point 2)
             (setf point (point-select-paragraph point)))
    (values :line point right)))

(defun point-select-around-paragraphs-down (point &key (n 1))
  (let ((space-start-p (point-empty-line-p point))
        (left (point-select-paragraph point)))
    (loop for i below n
          do (unless (= i 0)
               (point-end-of-line point 2))
             (when space-start-p
               (setf point (nth-value 1 (point-select-paragraph point)))
               (point-end-of-line point 2))
             (setf point (nth-value 1 (point-select-paragraph point)))
             (unless space-start-p
               (point-end-of-line point 2)
               (setf point (nth-value 1 (point-select-paragraph point)))))
    (values :line left point)))

(defun point-select-around-paragraphs-up (point &key (n 1))
  (let ((space-start-p (point-empty-line-p point))
        (right (nth-value 1 (point-select-paragraph point))))
    (loop for i below n
          do (unless (= i 0)
               (point-beginning-of-line point 2))
             (when space-start-p
               (setf point (point-select-paragraph point))
               (point-beginning-of-line point 2))
             (setf point (point-select-paragraph point))
             (unless space-start-p
               (point-beginning-of-line point 2)
               (setf point (point-select-paragraph point))))
    (values :line point right)))

(defun order-points (type p1 p2)
  (if (point<= p1 p2)
      (values type p1 p2)
      (values type p2 p1)))

(defun select-lines (buffer first last)
  (when (< last first) (psetf first last last first))
  (let* ((left  (text-coord-point (buffer-text buffer) (coord 0 first)))
         (right (text-coord-point (buffer-text buffer) (coord 0 last))))
    (point-end-of-line right)
    (values :line left right)))
