(in-package "FCL")


;; TODO: can remove this if iter.lisp is loaded before this file
#-boot
(defun simple-member (item list)
  (member item list))

(defmacro simple-pop (sym)
  (unless (symbolp sym)
    (error "SIMPLE-POP expects a symbol argument"))
  `(prog1 (car ,sym)
     (setq ,sym (cdr ,sym))))

(defun check-lambda-list-keys (list end1 end2 form allowed-keys)
  (let ((ret list))
    (setq end2 (- end2 end1))
    (loop while (> end1 0)
          do (if (consp list)
                 (setq list (cdr list) end1 (- end1 1))
                 (error "not enough arguments to lambda-list ~s~% ~s" form list)))
    (loop while (> end2 0)
          do (if (consp list)
                 (setq list (cdr list) end2 (- end2 1))
                 (return)))
    (flet ((allowed (true-key)
             (or (eql allowed-keys unbound-marker)
                 (loop for key in allowed-keys thereis (eql true-key key)))))
      (loop while (consp list)
            for key = (simple-pop list)
            with allow-other-keys = nil
            with unallowed-key = nil
            do (cond
                 ((consp list)
                  (let ((val (simple-pop list)))
                    (cond
                      ((eql key :allow-other-keys)
                       (setq allow-other-keys val))
                      ((allowed key))
                      (t (unless unallowed-key
                           (setq unallowed-key key))))))
                 ((null list)
                  (error "odd number of arguments passed to lambda-list ~s~% ~s" form list))
                 (t
                  (error "malformed list passed to lambda-list ~s~% ~s" form list)))
            finally (progn
                      (unless (null list)
                        (error "malformed list passed to lambda-list ~s~% ~s" form list))
                      (unless (or allow-other-keys (null unallowed-key))
                        (error "unallowed key ~s passed to lambda-list ~s~% ~s" unallowed-key form list)))))
    ret))

(defparameter *lambda-list-check-fn* nil)
(defparameter *lambda-list-reqend* nil)
(defparameter *lambda-list-optend* nil)
(defparameter *lambda-list-allowed-keys* nil)
(defparameter *lambda-list-allow-other-keys* nil)
(defparameter *lambda-list-allow-pattern* nil)
(defparameter *lambda-list-allow-body* nil)
(defparameter *lambda-list-allow-specializers* nil)
(defparameter *lambda-list-generic* nil)
(defparameter *lambda-list-vars* nil)
(defparameter *lambda-list-defaults* nil)
(defparameter *lambda-list-specializers* nil)


(macrolet ((check-malformed (cond)
             `(unless ,cond (error "malformed lambda-list")))
           (run-parse (name forms &rest args)
             (let ((list (make-symbol "LIST")))
               `(let ((,list (multiple-value-list (,name ,forms ,@args))))
                  (setq ,forms (car ,list))
                  (values-list (cdr ,list)))))
           (pop-key (forms key)
             `(when (and (consp ,forms) (eql ',key (car ,forms)))
                (setq ,forms (cdr ,forms))
                t))
           (with-parse-lambda-list (vars lambda-list &body body)
             (let ((bindings-end (make-symbol "BINDINGS-END"))
                   (list (car vars))
                   (list-sym (cadr vars))
                   (bindings (caddr vars)))
               `(with-ext-lists ((,bindings ,bindings-end))
                  (let ((,list ,lambda-list)
                        (,list-sym (make-symbol "LIST"))
                        (*lambda-list-check-fn* 'check-lambda-list)
                        (*lambda-list-reqend* 0)
                        (*lambda-list-optend* 0)
                        (*lambda-list-allowed-keys* nil)
                        (*lambda-list-allow-other-keys* nil)
                        (*lambda-list-allow-pattern* nil)
                        (*lambda-list-allow-body* nil)
                        (*lambda-list-allow-specializers* nil)
                        (*lambda-list-generic* nil)
                        (*lambda-list-vars* nil)
                        (*lambda-list-defaults* nil)
                        (*lambda-list-specializers* nil))
                    (declare (ignorable ,list-sym))
                    (macrolet ((append-bindings (list)
                                 `(append-tail ,list ,',bindings-end))
                               (push-bindings (list)
                                 `(push-tail ,list ,',bindings-end)))
                      ,@body)))))
           (end-parse (lambda-list)
             `(when ,lambda-list
                (error "invalid format for lambda-list:~% ~s" ,lambda-list))))
  (labels ((collect-form (forms)
             (unless (and (consp forms) (not (simple-member (car forms) lambda-list-keywords)))
               (error "a non-keyword argument is expected"))
             (values (cdr forms) (car forms)))
           (collect-forms (forms transform)
             (loop for forms on forms
                   while (not (simple-member (car forms) lambda-list-keywords))
                   collect (funcall transform (car forms)) into ret
                   finally (return (values forms ret))))
           (form-type (form)
             (cond
               ((symbolp form) :var)
               ((consp form) :pattern)))
           (add-var (var)
             (when (symbolp var)
               (setq *lambda-list-vars* (cons var *lambda-list-vars*))))
;;            (assoc (item alist)
;;              (loop for cons in alist when (eql item (car cons)) do (return cons)))
           (default-init (var init-form)
             (if (eql unbound-marker init-form)
                 (cdr (assoc var *lambda-list-defaults*))
                 init-form))
           (parse-reqvars (forms)
             (collect-forms
              forms
              (lambda (form)
                (let (type)
                  (when *lambda-list-allow-specializers*
                    (if (consp form)
                        (if (and (consp (cdr form)) (null (cddr form)))
                            (setq *lambda-list-specializers*
                                  (append *lambda-list-specializers* (list form))
                                  form (car form))
                            (error "invalid specializer argument ~s" form))
                        (setq *lambda-list-specializers*
                              (append *lambda-list-specializers* (list (list form unbound-marker))))))
                  (check-malformed (setq type (form-type form)))
                  (setq *lambda-list-reqend* (+ 1 *lambda-list-reqend*))
                  (setq *lambda-list-optend* (+ 1 *lambda-list-optend*))
                  (add-var form)
                  (list type form)))))
           (parse-reqvars-bindings (forms list-sym)
             (with-ext-lists ((bindings bindings-end))
               (loop for (type form) in (run-parse parse-reqvars forms)
                     do (append-tail (var-pattern-bindings type form `(simple-pop ,list-sym)) bindings-end))
               (values forms bindings)))
           (parse-optvar (form)
             (let ((var form) (type :var)
                   (init-form unbound-marker)
                   (supplied-p-parameter unbound-marker))
               (block nil
                 (when (symbolp form)
                   (return))
                 (check-malformed (consp form))
                 (setq var (car form) form (cdr form))
                 (check-malformed (setq type (form-type var)))
                 (when *lambda-list-generic*
                   (check-malformed (null form))
                   (return))
                 (when (consp form)
                   (setq init-form (car form) form (cdr form)))
                 (when (consp form)
                   (setq supplied-p-parameter (car form) form (cdr form))
                   (check-malformed (symbolp supplied-p-parameter)))
                 (check-malformed (null form)))
               (setq *lambda-list-optend* (+ 1 *lambda-list-optend*))
               (add-var var)
               (list type var init-form supplied-p-parameter)))
           (parse-optvars (forms)
             (if (pop-key forms &optional)
                 (collect-forms forms #'parse-optvar)
                 (values forms nil)))
           (parse-optvars-bindings (forms list-sym)
             (with-ext-lists ((bindings bindings-end))
               (loop for (type form init-form supplied-p-parameter) in (run-parse parse-optvars forms)
                     unless (eql unbound-marker supplied-p-parameter)
                       do (push-tail (list supplied-p-parameter `(if ,list-sym t nil)) bindings-end)
                     do (append-tail (var-pattern-bindings type form `(if ,list-sym
                                                                          (simple-pop ,list-sym)
                                                                          ,(default-init form init-form)))
                                     bindings-end))
               (values forms bindings)))
           (parse-restvar (forms)
             (if (or (pop-key forms &rest) (and *lambda-list-allow-body* (pop-key forms &body)))
                 (multiple-value-bind (forms var) (collect-form forms)
                   (let (type)
                     (check-malformed (setq type (form-type var)))
                     (setq *lambda-list-check-fn* 'check-lambda-list-rest)
                     (add-var var)
                     (values forms (list type var))))
                 (values forms nil)))
           (parse-restvar-bindings (forms list-sym)
             (aif (run-parse parse-restvar forms)
                  (values forms (var-pattern-bindings (car it) (cadr it) list-sym))
                  (values forms nil)))
           (parse-keyvar (form)
             (let ((var form) (type :var)
                   (init-form unbound-marker)
                   (supplied-p-parameter unbound-marker)
                   (keyword-name unbound-marker))
               (block nil
                 (when (symbolp form)
                   (return))
                 (check-malformed (consp form))
                 (setq var (car form) form (cdr form))
                 (when (consp var)
                   (check-malformed
                    (and (symbolp (setq keyword-name (car var)))
                         (consp (setq var (cdr var)))
                         (null (cdr var))))
                   (setq var (car var)))
                 (check-malformed (setq type (form-type var)))
                 (when *lambda-list-generic*
                   (check-malformed (null form))
                   (return))
                 (when (consp form)
                   (setq init-form (car form) form (cdr form)))
                 (when (consp form)
                   (setq supplied-p-parameter (car form) form (cdr form))
                   (check-malformed (symbolp supplied-p-parameter)))
                 (check-malformed (null form)))
               (when (eql keyword-name unbound-marker)
                 (setq keyword-name (intern (symbol-name var) keyword-package)))
               (setq *lambda-list-allowed-keys* (cons keyword-name *lambda-list-allowed-keys*))
               (add-var var)
               (list type var keyword-name init-form supplied-p-parameter)))
           (parse-keyvars (forms)
             (if (pop-key forms &key)
                 (let (ret)
                   (multiple-value-setq (forms ret)
                     (collect-forms forms #'parse-keyvar))
                   (setq *lambda-list-check-fn* 'check-lambda-list-keys)
                   (when (pop-key forms &allow-other-keys)
                     (setq *lambda-list-allow-other-keys* t))
                   (values forms ret))
                 (values forms nil)))
           (parse-keyvars-bindings (forms list-sym)
             (with-ext-lists ((bindings bindings-end))
               (loop for (type form keyword-name init-form supplied-p-parameter) in (run-parse parse-keyvars forms)
                     do (let* ((default-init (default-init form init-form))
                               (supplied-p (not (eql unbound-marker supplied-p-parameter)))
                               (need-intermediate (or default-init supplied-p))
                               (getf-sym (make-symbol "GETF"))
                               (getf-form `(getf ,list-sym ',keyword-name ,@(when need-intermediate '(unbound-marker)))))
                          (when need-intermediate
                            (push-tail (list getf-sym getf-form) bindings-end))
                          (when supplied-p
                            (push-tail (list supplied-p-parameter `(not (eql unbound-marker ,getf-sym))) bindings-end))
                          (append-tail (var-pattern-bindings type form (if need-intermediate
                                                                           `(if (eql unbound-marker ,getf-sym)
                                                                                ,default-init
                                                                                ,getf-sym)
                                                                           getf-form))
                                       bindings-end)))
               (values forms bindings)))
           (parse-auxvar (form)
             (let ((var form)
                   (init-form unbound-marker))
               (check-malformed
                (or (symbolp var)
                    (and (consp var)
                         (eql 2 (length var))
                         (symbolp (setq init-form (cadr var)
                                        var (car var))))))
               (add-var var)
               (list var init-form)))
           (parse-auxvars (forms)
             (if (pop-key forms &aux)
                 (collect-forms forms #'parse-auxvar)
                 (values forms nil)))
           (parse-auxvars-bindings (forms)
             (with-ext-lists ((bindings bindings-end))
               (loop for (var init-form) in (run-parse parse-auxvars forms)
                     do (push-tail (list var (default-init var init-form))
                                   bindings-end))
               (values forms bindings)))
           (parse-envvar (forms)
             (if (pop-key forms &environment)
                 (multiple-value-bind (forms var) (collect-form forms)
                   (check-malformed (symbolp var))
                   (add-var var)
                   (values forms t var))
                 (values forms nil nil)))
           (parse-envvar-bindings (forms env)
             (multiple-value-bind (matched var) (run-parse parse-envvar forms)
               (if matched
                   (values forms (list (list var env)))
                   (values forms nil))))
           (parse-wholevar (forms)
             (if (pop-key forms &whole)
                 (multiple-value-bind (forms var) (collect-form forms)
                   (check-malformed (symbolp var))
                   (add-var var)
                   (values forms t var))
                 (values forms nil nil)))
           (parse-wholevar-bindings (forms whole-form)
             (multiple-value-bind (matched var) (run-parse parse-wholevar forms)
               (if matched
                   (values forms (list (list var whole-form)))
                   (values forms nil))))
           (var-pattern-bindings (type var/pattern val)
             (ecase type
               (:var `((,var/pattern ,val)))
               (:pattern
                (unless *lambda-list-allow-pattern*
                  (error "pattern not allowed in lambda-list"))
                (expand-pattern var/pattern val))))
           (add-header (lambda-list list-sym form bindings)
             (list* `(,list-sym
                      (,*lambda-list-check-fn*
                       ,@(ecase *lambda-list-check-fn*
                           (check-lambda-list (list form *lambda-list-reqend* *lambda-list-optend* `',lambda-list))
                           (check-lambda-list-rest (list form *lambda-list-reqend* `'lambda-list))
                           (check-lambda-list-keys (list form *lambda-list-reqend* *lambda-list-optend* `',lambda-list
                                                         (list 'quote (if *lambda-list-allow-other-keys*
                                                                          unbound-marker
                                                                          *lambda-list-allowed-keys*)))))))
                    bindings)))
    
    (defun expand-pattern (lambda-list form)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-allow-pattern* t
              *lambda-list-allow-body* t)
        (append-bindings (run-parse parse-wholevar-bindings list list-sym))
        (append-bindings (run-parse parse-reqvars-bindings list list-sym))
        (append-bindings (run-parse parse-optvars-bindings list list-sym))
        (if (and list (symbolp list))
            (progn
              (push-bindings (list list list-sym))
              (setq list nil))
            (progn
              (append-bindings (run-parse parse-restvar-bindings list list-sym))
              (append-bindings (run-parse parse-keyvars-bindings list list-sym))
              (append-bindings (run-parse parse-auxvars-bindings list))))
        (end-parse list)
        (add-header lambda-list list-sym form bindings)))

    (defun expand-lambda-list (lambda-list form)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (append-bindings (run-parse parse-reqvars-bindings list list-sym))
        (append-bindings (run-parse parse-optvars-bindings list list-sym))
        (append-bindings (run-parse parse-restvar-bindings list list-sym))
        (append-bindings (run-parse parse-keyvars-bindings list list-sym))
        (append-bindings (run-parse parse-auxvars-bindings list))
        (end-parse list)
        (add-header lambda-list list-sym form bindings)))

    (defun parse-generic-lambda-list (lambda-list)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-generic* t)
        (let ((reqvars (mapcar #'cadr (run-parse parse-reqvars list)))
              (optvars (mapcar #'cadr (run-parse parse-optvars list)))
              (restvar (run-parse parse-restvar list))
              (keyvars (mapcar #'caddr (run-parse parse-keyvars list))))
          (end-parse list)
          (when (eql 0 (list-length reqvars))
            (error "generic functions must have at least one required argument"))
          (values reqvars
                  (list (list-length reqvars)
                        (list-length optvars)
                        (and restvar t)
                        (eql *lambda-list-check-fn* 'check-lambda-list-keys)
                        keyvars
                        *lambda-list-allow-other-keys*)))))

    (defun parse-method-lambda-list (lambda-list)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-allow-specializers* t)
        (let ((reqvars (mapcar #'cadr (run-parse parse-reqvars list)))
              (optvars (mapcar #'cadr (run-parse parse-optvars list)))
              (restvar (run-parse parse-restvar list))
              (keyvars (mapcar #'caddr (run-parse parse-keyvars list))))
          (run-parse parse-auxvars list)
          (end-parse list)
          (list (list-length reqvars)
                (list-length optvars)
                (and restvar t)
                (eql *lambda-list-check-fn* 'check-lambda-list-keys)
                keyvars
                *lambda-list-allow-other-keys*))))

    (defun convert-method-lambda-list-to-generic-lambda-list (lambda-list)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-allow-specializers* t)
        (let ((reqvars (mapcar #'cadr (run-parse parse-reqvars list)))
              (optvars (mapcar #'cadr (run-parse parse-optvars list)))
              (restvar (run-parse parse-restvar list)))
          (run-parse parse-keyvars list)
          (run-parse parse-auxvars list)
          (end-parse list)
          `(,@reqvars
            ,@(when optvars `(&optional ,@optvars))
            ,@(when restvar `(&rest ,restvar))
            ,@(when (eql *lambda-list-check-fn* 'check-lambda-list-keys)
                `(&key))))))

    (defun expand-specialized-lambda-list (lambda-list form)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-allow-specializers* t)
        (append-bindings (run-parse parse-reqvars-bindings list list-sym))
        (append-bindings (run-parse parse-optvars-bindings list list-sym))
        (append-bindings (run-parse parse-restvar-bindings list list-sym))
        (append-bindings (run-parse parse-keyvars-bindings list list-sym))
        (append-bindings (run-parse parse-auxvars-bindings list))
        (end-parse list)
        (values (add-header lambda-list list-sym form bindings)
                *lambda-list-specializers*)))

    (defun expand-boa-lambda-list (lambda-list form defaults)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-defaults* defaults)
        (append-bindings (run-parse parse-reqvars-bindings list list-sym))
        (append-bindings (run-parse parse-optvars-bindings list list-sym))
        (append-bindings (run-parse parse-restvar-bindings list list-sym))
        (append-bindings (run-parse parse-keyvars-bindings list list-sym))
        (append-bindings (run-parse parse-auxvars-bindings list))
        (end-parse list)
        (values (add-header lambda-list list-sym form bindings)
                *lambda-list-vars*)))

    (defun expand-macro-lambda-list (lambda-list form env)
      (with-parse-lambda-list (list list-sym bindings) lambda-list
        (setq *lambda-list-allow-pattern* t
              *lambda-list-allow-body* t)
        (let ((envar-found nil)
              (form-sym (unless (or (symbolp form) (constantp form))
                          (make-symbol "FORM"))))
          (flet ((maybe-parse-envvar ()
                   (awhen (run-parse parse-envvar-bindings list env)
                     (when envar-found
                       (error "duplicate &environment clauses"))
                     (setq envar-found t)
                     (append-bindings it))))
            (append-bindings (run-parse parse-wholevar-bindings list (or form-sym form)))
            (maybe-parse-envvar)
            (append-bindings (run-parse parse-reqvars-bindings list list-sym))
            (maybe-parse-envvar)
            (append-bindings (run-parse parse-optvars-bindings list list-sym))
            (maybe-parse-envvar)
            (if (and list (symbolp list))
                (progn
                  (push-bindings (list list list-sym))
                  (setq list nil))
                (progn
                  (append-bindings (run-parse parse-restvar-bindings list list-sym))
                  (maybe-parse-envvar)
                  (append-bindings (run-parse parse-keyvars-bindings list list-sym))
                  (maybe-parse-envvar)
                  (append-bindings (run-parse parse-auxvars-bindings list))
                  (maybe-parse-envvar)))
            (end-parse list)
            (append (when form-sym (list (list form-sym form)))
                    (add-header lambda-list list-sym `(cdr ,(or form-sym form)) bindings))))))

    (defun expand-modify-macro-lambda-list (lambda-list)
      (with-parse-lambda-list (list list-sym vars) lambda-list
        (setq list-sym 'list)
        (append-bindings (loop for (type var) in (run-parse parse-reqvars list)
                               collect var))
        (append-bindings (loop for (type var) in (run-parse parse-optvars list)
                               collect var))
        (awhen (run-parse parse-restvar list)
          (setq list-sym 'list*)
          (push-bindings (cadr it)))
        (list* list-sym vars)))

    (defmacro macro-lambda (lambda-list &rest body)
      (let ((form-sym (make-symbol "FORM"))
            (env-sym (make-symbol "ENV")))
        `#'(lambda (,form-sym ,env-sym)
             (declare (ignorable ,env-sym))
             (let* ,(expand-macro-lambda-list lambda-list form-sym env-sym)
               ,@body))))))
