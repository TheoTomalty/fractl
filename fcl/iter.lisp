(in-package #:fr-int)


(defun prognify (forms)
  (if (and (consp forms) (cdr forms))
      `(progn ,@forms)
      (car forms)))

(defun extract-declarations (body)
  (with-ext-lists ((declarations declarations-end)
                   (new-body body-end))
    (tagbody
     decls
       (unless (and (consp body) (consp (car body)) (eql 'declare (caar body)))
         (go end))
       (push-tail (car body) declarations-end)
       (setq body (cdr body))
       (go decls)
     end)
    (values declarations body)))

(defun expand-do (kind varlist endlist body)
  (let (declarations)
    (with-ext-lists ((bindings bindings-end)
                     (update update-end))
      (tagbody
       begin
         (unless varlist
           (go decls))
         (let ((binding (car varlist))
               name init-form)
           (setq name (car binding)
                 init-form (cadr binding)
                 binding (cddr binding))
           (push-tail (list name init-form) bindings-end)
           (when binding
             (push-tail name update-end)
             (push-tail (car binding) update-end)))
         (setq varlist (cdr varlist))
         (go begin)
       decls
         (multiple-value-setq (declarations body)
           (extract-declarations body))
       end)
      (let ((begin-sym (make-symbol "BEGIN"))
            (end-sym (make-symbol "END"))
            (test-form (car endlist))
            (return-forms (cdr endlist)))
        `(block nil
           (,(ecase kind (do 'let) (do* 'let*)) ,bindings
            ,@declarations
            (tagbody
               ,begin-sym
               (when ,test-form
                 (go ,end-sym))
               (tagbody ,@body)
               ,@(when update
                   `((,(ecase kind (do 'psetq) (do* 'setq)) ,@update)))
               (go ,begin-sym)
               ,end-sym
               (return-from nil ,(prognify return-forms)))))))))

(defmacro do (varlist endlist &rest body)
  (expand-do 'do varlist endlist body))

(defmacro do* (varlist endlist &rest body)
  (expand-do 'do* varlist endlist body))

(defmacro dotimes (binding &rest body)
  (let ((var (car binding))
        (count (cadr binding))
        (result (caddr binding))
        (count-sym (make-symbol "COUNT"))
        (begin-sym (make-symbol "BEGIN"))
        (end-sym (make-symbol "END")))
    `(block nil
       (let ((,var 0) (,count-sym ,count))
         (declare (ignorable ,var))
         (tagbody
            ,begin-sym
            (unless (< ,var ,count-sym)
              (go ,end-sym))
            (tagbody ,@body)
            (setq ,var (+ ,var 1))
            (go ,begin-sym)
            ,end-sym)))))

(defmacro dolist (binding &rest body)
  (let ((var (car binding))
        (list (cadr binding))
        (result (caddr binding))
        (list-sym (make-symbol "LIST"))
        (begin-sym (make-symbol "BEGIN"))
        (end-sym (make-symbol "END")))
    `(block nil
       (let ((,list-sym ,list))
         (declare (ignorable ,var))
         (tagbody
            ,begin-sym
            (when (endp ,list-sym)
              (go ,end-sym))
            (let ((,var (car ,list-sym)))
              (tagbody ,@body))
            (setq ,list-sym (cdr ,list-sym))
            (go ,begin-sym)
            ,end-sym
            (return ,result))))))

(defmacro simple-loop (&rest forms)
  (let ((begin-sym (make-symbol "BEGIN")))
    `(block nil
       (tagbody
          ,begin-sym
          (progn ,@forms)
          (go ,begin-sym)))))

(defun flatten (tree)
  (cond
    ((consp tree)
     (append (flatten (car tree)) (flatten (cdr tree))))
    ((null tree)
     nil)
    (t (list tree))))

(defun d-var-bindings (tree)
  (with-ext-lists ((bindings bindings-end))
    (dolist (var (flatten tree) bindings)
      (push-tail (list var nil) bindings-end))))

(defmacro d-var-setq (vars form)
  (cond
    ((consp vars)
     (let ((tmp-sym (make-symbol "TMP")))
       `(let ((,tmp-sym ,form))
          (d-var-setq ,(car vars) (car ,tmp-sym))
          (d-var-setq ,(cdr vars) (cdr ,tmp-sym)))))
    ((null vars) nil)
    (t `(setq ,vars ,form))))

(defun simple-member (item list)
  (dolist (test-item list)
    (when (eql test-item item)
      (return-from simple-member t))))

(defmacro loop-finish ()
  `(go loop-end))

(defmacro extended-loop (&rest forms)
  (let (name it-sym first-sym list-return sum-return minmax-return bool-return)
    (with-ext-lists ((bindings bindings-end)
                     (prologue prologue-end)
                     (epilogue epilogue-end)
                     (termination-tests termination-tests-end)
                     (updates updates-end)
                     (body body-end))
      (labels ((pop-form ()
                 (prog1 (car forms)
                   (setq forms (cdr forms))))
               (pop-form-strict ()
                 (unless (consp forms)
                   (error "no more forms"))
                 (pop-form))
               (peek-kwd (&rest kwds)
                 (let ((symbol (car forms)))
                   (when (and symbol (symbolp symbol))
                     (let ((true-kwd (symbol-name symbol)))
                       (dolist (kwd kwds)
                         (when (string= kwd true-kwd)
                           (return-from peek-kwd t)))
                       nil))))
               (peek-kwd-strict (&rest kwds)
                 (unless (consp forms)
                   (error "no more forms"))
                 (unless (apply #'peek-kwd kwds)
                   (error "unexpected keyword")))
               (pop-kwd (&rest kwds)
                 (when (apply #'peek-kwd kwds)
                   (pop-form)))
               (pop-kwd-strict (&rest kwds)
                 (unless (consp forms)
                   (error "no more forms"))
                 (unless (apply #'peek-kwd kwds)
                   (error "unexpected keyword"))
                 (pop-form))
               (parse-name-clause ()
                 (when (pop-kwd "NAMED")
                   (setq name (pop-form-strict))
                   (unless (symbolp name)
                     (error "name must be a symbol"))
                   t))
               (parse-type-spec ()
                 (when forms
                   (when (simple-member (car forms) '(fixnum float t nil))
                     (return-from parse-type-spec (values t (pop-form-strict)))))
                 (when (pop-kwd "OF-TYPE")
                   (values t (pop-form-strict))))
               (parse-and-subclauses (parse-subclause)
                 (do () ((not (pop-kwd "AND")))
                   (funcall parse-subclause)))
               (parse-with-clause ()
                 (when (pop-kwd "WITH")
                   (with-ext-lists ((local-bindings local-bindings-end)
                                    (setq-list setq-list-end))
                     (labels ((parse-subclause ()
                                (let ((var (pop-form-strict))
                                      init-form)
                                  (parse-type-spec)
                                  (unless (symbolp var)
                                    (error "var must be a symbol"))
                                  (awhen (pop-kwd "=")
                                    (setq init-form (pop-form-strict)))
                                  (append-tail (d-var-bindings var) local-bindings-end)
                                  (push-tail `(d-var-setq ,var ,init-form) setq-list-end))))
                       (parse-subclause)
                       (parse-and-subclauses #'parse-subclause)
                       (push-tail `(let ,local-bindings ,@setq-list) bindings-end)
                       t))))
               (parse-compound-form+ ()
                 (with-ext-lists ((compound-forms compound-forms-end))
                   (let ((first-form (pop-form-strict)))
                     (unless (consp first-form)
                       (error "unexpected keyword"))
                     (push-tail first-form compound-forms-end))
                   (do () ((not (and (consp forms) (consp (car forms)))) compound-forms)
                     (push-tail (pop-form-strict) compound-forms-end))))
               (parse-initally-clause ()
                 (when (pop-kwd "INITIALLY")
                   (append-tail (parse-compound-form+) prologue-end)
                   t))
               (parse-finally-clause ()
                 (when (pop-kwd "FINALLY")
                   (append-tail (parse-compound-form+) epilogue-end)
                   t))
               (parse-do-clause (&optional parse-it)
                 (declare (ignore parse-it))
                 (when (pop-kwd "DO" "DOING")
                   (let ((forms (parse-compound-form+)))
                     (values t (prognify forms) nil))))
               (ensure-it ()
                 (unless it-sym
                   (setq it-sym (make-symbol "IT"))))
               (parse-it (parse-it)
                 (if parse-it
                     (let ((it (pop-kwd "IT")))
                       (if it
                           (progn
                             (ensure-it)
                             (values it-sym t))
                           (values (pop-form-strict) nil)))
                     (values (pop-form-strict) nil)))
               (parse-return-clause (&optional parse-it)
                 (when (pop-kwd "RETURN")
                   (multiple-value-bind (form it) (parse-it parse-it)
                     (values t `(return-from ,name ,form) it))))
               (ensure-list-accumulation ()
                 (when (or sum-return minmax-return bool-return)
                   (error "incompatible LOOP return kinds"))
                 (unless list-return
                   (setq list-return (cons (make-symbol "HEAD") (make-symbol "TAIL")))))
               (ensure-sum-accumulation ()
                 (when (or list-return minmax-return bool-return)
                   (error "incompatible LOOP return kinds"))
                 (unless sum-return
                   (setq sum-return (make-symbol "SUM"))))
               (ensure-minmax-accumulation ()
                 (when (or list-return sum-return bool-return)
                   (error "incompatible LOOP return kinds"))
                 (unless minmax-return
                   (setq minmax-return (cons (make-symbol "MINMAX") (make-symbol "MINMAX-FLAG")))))
               (ensure-bool-accumulation (initial-value)
                 (when (or list-return sum-return minmax-return)
                   (error "incompatible LOOP return kinds"))
                 (if bool-return
                     (unless (equal initial-value (car bool-return))
                       (error "incompatible LOOP boolean initial values"))
                     (setq bool-return (list initial-value))))
               (parse-into-clause ()
                 (when (pop-kwd "INTO")
                   (let ((var (pop-form-strict)))
                     (unless (symbolp var)
                       (error "INTO argument must be a symbol"))
                     (values t var))))
               (parse-list-accumulation-clause (push-sym parse-it)
                 (multiple-value-bind (form it) (parse-it parse-it)
                   (multiple-value-bind (into var) (parse-into-clause)
                     (if into
                         (let ((head-sym (make-symbol "HEAD"))
                               (tail-sym (make-symbol "TAIL")))
                           (push-tail `(let* ((,head-sym (list nil))
                                              (,tail-sym ,head-sym)
                                              (,var nil)))
                                      bindings-end)
                           (values t
                                   `(progn
                                      (,push-sym ,form ,tail-sym)
                                      (setq ,var (cdr ,head-sym)))
                                   it))
                         (progn
                           (ensure-list-accumulation)
                           (values t `(,push-sym ,form ,(cdr list-return)) it))))))
               (parse-collect-clause (&optional parse-it)
                 (when (pop-kwd "COLLECT" "COLLECTING")
                   (parse-list-accumulation-clause 'push-tail parse-it)))
               (parse-append-clause (&optional parse-it)
                 (when (pop-kwd "APPEND" "APPENDING")
                   (parse-list-accumulation-clause 'append-tail parse-it)))
               (parse-nconc-clause (&optional parse-it)
                 (when (pop-kwd "NCONC" "NCONCING")
                   (parse-list-accumulation-clause 'nconc-tail parse-it)))
               (parse-sum-accumulation-clause (update parse-it)
                 (multiple-value-bind (form it) (parse-it parse-it)
                   (multiple-value-bind (into var) (parse-into-clause)
                     (parse-type-spec)
                     (if into
                         (progn
                           (push-tail `(let ((,var 0))) bindings-end)
                           (values t (funcall update form var) it))
                         (progn
                           (ensure-sum-accumulation)
                           (values t (funcall update form sum-return) it))))))
               (parse-count-clause (&optional parse-it)
                 (when (pop-kwd "COUNT" "COUNTING")
                   (parse-sum-accumulation-clause
                    (lambda (form sym) `(when ,form (setq ,sym (1+ ,sym))))
                    parse-it)))
               (parse-sum-clause (&optional parse-it)
                 (when (pop-kwd "SUM" "SUMMING")
                   (parse-sum-accumulation-clause
                    (lambda (form sym) `(setq ,sym (+ ,sym ,form)))
                    parse-it)))
               (generate-minmax-form (cmp form minmax minmax-flag)
                 (let ((tmp-sym (make-symbol "MINMAX-TMP")))
                   `(let ((,tmp-sym ,form))
                      (if (or (not ,minmax-flag) (,cmp ,tmp-sym ,minmax))
                          (setq ,minmax ,tmp-sym
                                ,minmax-flag t)))))
               (parse-minmax-accumulation-clause (cmp parse-it)
                 (multiple-value-bind (form it) (parse-it parse-it)
                   (multiple-value-bind (into var) (parse-into-clause)
                     (parse-type-spec)
                     (if into
                         (let ((minmax-sym (make-sym "MINMAX"))
                               (flag-sym (make-sym "MINMAX-FLAG")))
                           (push-tail `(let ((,minmax-sym 0) (,flag-sym nil))) bindings-end)
                           (values t (generate-minmax-form cmp form minmax-sym flag-sym) it))
                         (progn
                           (ensure-minmax-accumulation)
                           (values t (generate-minmax-form cmp form (car minmax-return) (cdr minmax-return)) it))))))
               (parse-maximize-clause (&optional parse-it)
                 (when (pop-kwd "MAXIMIZE" "MAXIMIZING")
                   (parse-minmax-accumulation-clause '> parse-it)))
               (parse-minimize-clause (&optional parse-it)
                 (when (pop-kwd "MINIMIZE" "MINIMIZING")
                   (parse-minmax-accumulation-clause '< parse-it)))
               (parse-condition-clause (&optional parse-it)
                 (let (negate)
                   (when (or (pop-kwd "IF" "WHEN") (setq negate (pop-kwd "UNLESS")))
                     (with-ext-lists ((then-forms then-forms-end)
                                      (else-forms else-forms-end))
                       (let ((test (pop-form-strict))
                             it-used else-p)
                         (labels ((parse-subclause ()
                                    (multiple-value-bind (form it)
                                        (parse-selectable-clause-strict)
                                      (when it
                                        (setq it-used t))
                                      (if else-p
                                          (push-tail form else-forms-end)
                                          (push-tail form then-forms-end))))
                                  (negate (form)
                                    (if negate `(not ,form) form)))
                           (parse-subclause)
                           (parse-and-subclauses #'parse-subclause)
                           (when (pop-kwd "ELSE")
                             (setq else-p t)
                             (parse-subclause)
                             (parse-and-subclauses #'parse-subclause))
                           (pop-kwd "END")
                           (values t
                                   `(if ,(negate (if it-used `(setq ,it-sym ,test) test))
                                        ,(prognify then-forms)
                                        ,@(when then-forms
                                            (list (prognify else-forms))))
                                   nil)))))))
               (%parse-selectable-clause (&optional parse-it)
                 (macrolet ((try (name)
                              `(multiple-value-bind (matched form it) (,name parse-it)
                                 (when matched
                                   (return-from %parse-selectable-clause (values t form it))))))
                   (try parse-do-clause)
                   (try parse-return-clause)
                   (try parse-collect-clause)
                   (try parse-append-clause)
                   (try parse-nconc-clause)
                   (try parse-count-clause)
                   (try parse-sum-clause)
                   (try parse-maximize-clause)
                   (try parse-minimize-clause)
                   (try parse-condition-clause)))
               (parse-selectable-clause-strict ()
                 (multiple-value-bind (matched form it)
                     (%parse-selectable-clause t)
                   (unless matched
                     (error "expected a selectable clause"))
                   (values form it)))
               (parse-selectable-clause (&optional parse-it)
                 (multiple-value-bind (matched form)
                     (%parse-selectable-clause)
                   (when matched
                     (push-tail form body-end)
                     t)))
               (parse-while-clause ()
                 (when (pop-kwd "WHILE")
                   (push-tail `(unless ,(pop-form-strict) (go loop-end))
                              termination-tests-end)
                   t))
               (parse-until-clause ()
                 (when (pop-kwd "UNTIL")
                   (push-tail `(when ,(pop-form-strict) (go loop-end))
                              termination-tests-end)
                   t))
               (parse-repeat-clause ()
                 (when (pop-kwd "REPEAT")
                   (let ((counter (make-symbol "REPEAT")))
                     (push-tail `(let (,counter ,(pop-form-strict))) bindings-end)
                     (push-tail `(if (<= ,counter 0)
                                     (go loop-end)
                                     (setq ,counter (- ,counter 1)))
                                termination-tests-end)
                     t)))
               (parse-always-clause ()
                 (when (pop-kwd "ALWAYS")
                   (ensure-bool-accumulation t)
                   (push-tail `(unless ,(pop-form-strict) (return-from ,name nil))
                              termination-tests-end)
                   t))
               (parse-never-clause ()
                 (when (pop-kwd "NEVER")
                   (ensure-bool-accumulation t)
                   (push-tail `(when ,(pop-form-strict) (return-from ,name nil))
                              termination-tests-end)
                   t))
               (parse-thereis-clause ()
                 (when (pop-kwd "THEREIS")
                   (ensure-it)
                   (push-tail `(when (setq ,it-sym ,(pop-form-strict)) (return-from ,name ,it-sym))
                              termination-tests-end)
                   t))
               (parse-for-arithmetic-from-clause (var)
                 (when (pop-kwd "FROM")
                   (values t (list (list var (pop-form-strict))) t nil nil nil nil)))
               (parse-for-arithmetic-downfrom-clause (var)
                 (when (pop-kwd "DOWNFROM")
                   (values t (list (list var (pop-form-strict))) t nil nil nil :down)))
               (parse-for-arithmetic-upfrom-clause (var)
                 (when (pop-kwd "UPFROM")
                   (values t (list (list var (pop-form-strict))) t nil nil nil :up)))
               (parse-for-arithmetic-to-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "TO")
                   (let ((to-sym (make-symbol "TO")))
                     (values t (list (list to-sym (pop-form-strict))) nil to-sym nil :include nil))))
               (parse-for-arithmetic-downto-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "DOWNTO")
                   (let ((to-sym (make-symbol "TO")))
                     (values t (list (list to-sym (pop-form-strict))) nil to-sym nil :include :down))))
               (parse-for-arithmetic-upto-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "UPTO")
                   (let ((to-sym (make-symbol "TO")))
                     (values t (list (list to-sym (pop-form-strict))) nil to-sym nil :include :up))))
               (parse-for-arithmetic-below-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "BELOW")
                   (let ((to-sym (make-symbol "TO")))
                     (values t (list (list to-sym (pop-form-strict))) nil to-sym nil :exclude :up))))
               (parse-for-arithmetic-above-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "ABOVE")
                   (let ((to-sym (make-symbol "TO")))
                     (values t (list (list to-sym (pop-form-strict))) nil to-sym nil :exclude :down))))
               (parse-for-arithmetic-by-clause (var)
                 (declare (ignore var))
                 (when (pop-kwd "BY")
                   (let ((step-sym (make-symbol "STEP")))
                     (values t (list (list step-sym (pop-form-strict))) nil nil step-sym nil nil))))
               (parse-for-arithmetic-subclause (var)
                 (macrolet ((try (name)
                              `(multiple-value-bind (matched bindings from to step inclusivity direction)
                                   (,name var)
                                 (when matched
                                   (return-from parse-for-arithmetic-subclause
                                     (values matched bindings from to step inclusivity direction))))))
                   (try parse-for-arithmetic-from-clause)
                   (try parse-for-arithmetic-downfrom-clause)
                   (try parse-for-arithmetic-upfrom-clause)
                   (try parse-for-arithmetic-to-clause)
                   (try parse-for-arithmetic-downto-clause)
                   (try parse-for-arithmetic-upto-clause)
                   (try parse-for-arithmetic-below-clause)
                   (try parse-for-arithmetic-above-clause)
                   (try parse-for-arithmetic-by-clause)))
               (parse-for-arithmetic-clause (var)
                 (with-ext-lists ((local-bindings local-bindings-end))
                   (let (one-matched true-from true-to true-step true-inclusivity true-direction)
                     (do () (nil)
                       (multiple-value-bind (matched bindings from to step inclusivity direction)
                           (parse-for-arithmetic-subclause var)
                         (unless matched
                           (return))
                         (setq one-matched t)
                         (append-tail bindings local-bindings-end)
                         (macrolet ((maybe-update (true-var var msg)
                                      `(when ,var
                                         (when ,true-var (error ,msg))
                                         (setq ,true-var ,var)))
                                    (maybe-update* (true-var var msg)
                                      `(when ,var
                                         (when (and ,true-var (not (eql ,true-var ,var)))
                                           (error ,msg))
                                         (setq ,true-var ,var))))
                           (maybe-update true-from from "duplicate FROM clause in arithmetic FOR clause")
                           (maybe-update true-to to "duplicate TO clause in arithmetic FOR clause")
                           (maybe-update true-step step "duplicate BY clause in arithmetic FOR clause")
                           (maybe-update* true-inclusivity inclusivity "conflicting inclusivity in arithmetic FOR clause")
                           (maybe-update* true-direction direction "conflicting inclusivity in arithmetic FOR clause"))))
                     (unless one-matched
                       (return-from parse-for-arithmetic-clause nil))
                     (unless (symbolp var)
                       (error "can not destructure arithmetic argument"))
                     (unless true-from
                       (push-tail (list var 0) local-bindings-end))
                     (unless true-step (setq true-step 1))
                     (unless true-direction (setq true-direction :up))
                     (values t local-bindings nil
                             (when true-to
                               `(when (,(ecase true-direction
                                          (:up
                                           (ecase true-inclusivity (:include '>) (:exclude '>=)))
                                          (:down
                                           (ecase true-inclusivity (:include '<) (:exclude '<=))))
                                       ,var ,true-to)
                                  (loop-finish)))
                             `(setq ,var (,(ecase true-direction (:up '+) (:down '-)) ,var ,true-step))))))
               (parse-for-in-by-clause ()
                 (if (pop-kwd "BY")
                     (pop-form-strict)
                     '#'cdr))
               (parse-for-in-on-clause (var)
                 (let (on)
                   (when (or (pop-kwd "IN") (setq on (pop-kwd "ON")))
                     (let ((list-form (pop-form-strict))
                           (by-form (parse-for-in-by-clause))
                           (list-sym (make-symbol "LIST"))
                           by-sym)
                       (values
                        t
                        (append
                         (d-var-bindings var)
                         (list* (list list-sym list-form)
                                (if (and (consp by-form) (eql 'function (car by-form)))
                                    nil
                                    (list (list (setq by-sym (make-symbol "BY")) by-form)))))
                        nil
                        (let ((update-list-sym
                                `(setq ,list-sym (,@(if by-sym `(funcall ,by-sym) (list (cadr by-form)))
                                                  ,list-sym))))
                          (if on
                              `(progn
                                 (d-var-setq ,var ,list-sym)
                                 (if (atom ,list-sym) (loop-finish) ,update-list-sym))
                              `(if (endp ,list-sym)
                                   (loop-finish)
                                   (progn
                                     (d-var-setq ,var (car ,list-sym))
                                     ,update-list-sym))))
                        nil)))))
               (ensure-first ()
                 (unless first-sym
                   (setq first-sym (make-symbol "FIRST"))))
               (parse-for-equals-clause (var)
                 (when (pop-kwd "=")
                   (let* ((form (pop-form-strict))
                          (then (pop-kwd "THEN"))
                          (then-form (when then
                                       (ensure-first)
                                       (pop-form-strict))))
                     (values
                      t
                      (d-var-bindings var)
                      nil
                      (if then
                          `(d-var-setq ,var (if ,first-sym ,form ,then-form))
                          `(d-var-setq ,var ,form))
                      nil))))
               (parse-for-across-clause (var)
                 (when (pop-kwd "ACROSS")
                   (let ((form (pop-form-strict))
                         (vector-sym (make-symbol "VECTOR"))
                         (index-sym (make-symbol "INDEX"))
                         (length-sym (make-symbol "LENGTH")))
                     (values
                      t
                      (append (d-var-bindings var)
                              (list (list vector-sym form) (list index-sym 0)))
                      `(let ((,length-sym (length ,vector-sym))))
                      `(if (>= ,index-sym ,length-sym)
                           (loop-finish)
                           (progn
                             (d-var-setq ,var (aref ,vector-sym ,index-sym))
                             (setq ,index-sym (+ ,index-sym 1))))
                      nil))))
               (parse-for-hash-clause (var)
                 (let (values)
                   (when (or (pop-kwd "HASH-KEYS" "HASH-KEY")
                             (setq values (pop-kwd "HASH-VALUES" "HASH-VALUE")))
                     (pop-kwd-strict "IN" "OF")
                     (let ((form (pop-form-strict))
                           (key-d-var (if values nil var))
                           (value-d-var (if values var nil))
                           (key-sym (make-symbol "KEY"))
                           (value-sym (make-symbol "VALUE"))
                           (tmp-sym (make-symbol "TMP"))
                           (table-sym (make-symbol "TABLE"))
                           (next-sym (make-symbol "NEXT")))
                       (when (pop-kwd "USING")
                         (let ((form (pop-form-strict)))
                           (unless (and (consp form)
                                        (symbolp (car form))
                                        (string= (if values "HASH-KEY" "HASH-VALUE") (symbol-name (car form)))
                                        (eql 2 (length form)))
                             (error "invalid USING form"))
                           (if values (setq key-d-var (cadr form)) (setq value-d-var (cadr form)))))
                       (values
                        t
                        (list (list tmp-sym nil) (list key-sym nil) (list value-sym nil) (list table-sym form))
                        `(with-hash-table-iterator (,next-sym ,table-sym))
                        `(when (not (multiple-value-setq (,tmp-sym ,key-sym ,value-sym) (,next-sym)))
                           (loop-finish))
                        `(progn
                           ,@(when key-d-var
                               `((d-var-setq ,key-d-var ,key-sym)))
                           ,@(when value-d-var
                               `((d-var-setq ,value-d-var ,value-sym)))))))))
               (parse-for-package-clause (var)
                 (let (present external)
                   (when (or (pop-kwd "SYMBOL" "SYMBOLS")
                             (setq present (pop-kwd "PRESENT-SYMBOL" "PRESENT-SYMBOLS"))
                             (setq external (pop-kwd "EXTERNAL-SYMBOL" "EXTERNAL-SYMBOLS")))
                     (pop-kwd-strict "IN" "OF")
                     (let ((form (pop-form-strict))
                           (tmp-sym (make-symbol "TMP"))
                           (package-sym (make-symbol "PACKAGE"))
                           (next-sym (make-symbol "NEXT"))
                           (sym-sym (make-symbol "SYM")))
                       (values
                        t
                        (append (d-var-bindings var)
                                (list (list tmp-sym nil) (list package-sym form)))
                        `(with-package-iterator (,next-sym
                                                 ,package-sym
                                                 ,@(cond
                                                     (present `(:internal :external))
                                                     (external `(:external))
                                                     (t `(:internal :external :inherited)))))
                        `(when (not (multiple-value-setq (,tmp-sym ,sym-sym) (,next-sym)))
                           (loop-finish))
                        `(d-var-setq ,var ,sym-sym))))))
               (parse-for-being-the-clause (var)
                 (when (and (pop-kwd "BEING") (pop-kwd-strict "THE" "EACH"))
                   (let (list)
                     (setq list (multiple-value-list (parse-for-hash-clause var)))
                     (unless (car list)
                       (setq list (multiple-value-list (parse-for-package-clause var))))
                     (unless (car list)
                       (error "expected hash-table or package clause after BEING THE"))
                     (values-list list))))
               (parse-for-subclause-strict ()
                 (let ((var (pop-form-strict)))
                   (parse-type-spec)
                   (macrolet ((try (name)
                                `(multiple-value-bind (matched bindings special-iterator termination-test update)
                                     (,name var)
                                   (when matched
                                     (return-from parse-for-subclause-strict
                                       (values bindings special-iterator termination-test update))))))
                     (try parse-for-arithmetic-clause)
                     (try parse-for-in-on-clause)
                     (try parse-for-equals-clause)
                     (try parse-for-across-clause)
                     (try parse-for-being-the-clause)
                     (error "expected FOR subclause"))))
               (parse-for-clause ()
                 (when (pop-kwd "FOR" "AS")
                   (with-ext-lists ((local-bindings local-bindings-end)
                                    (special-iterators special-iterators-end))
                     (labels ((parse-subclause ()
                                (multiple-value-bind (bindings special-iterator termination-test update)
                                    (parse-for-subclause-strict)
                                  (append-tail bindings local-bindings-end)
                                  (when special-iterator
                                    (push-tail special-iterator special-iterators-end))
                                  (when termination-test
                                    (push-tail termination-test termination-tests-end))
                                  (when update
                                    (push-tail update updates-end)))))
                       (parse-subclause)
                       (parse-and-subclauses #'parse-subclause)
                       (push-tail `(let ,local-bindings) bindings-end)
                       (append-tail special-iterators bindings-end)
                       t))))
               (parse-main-clause ()
                 (macrolet ((try (name)
                              `(when (,name)
                                 (return-from parse-main-clause t))))
                   (try parse-name-clause)
                   (try parse-with-clause)
                   (try parse-initally-clause)
                   (try parse-finally-clause)
                   (try parse-selectable-clause)
                   (try parse-while-clause)
                   (try parse-until-clause)
                   (try parse-repeat-clause)
                   (try parse-always-clause)
                   (try parse-never-clause)
                   (try parse-thereis-clause)
                   (try parse-for-clause)))
               (parse-main-clause-strict ()
                 (unless (parse-main-clause)
                   (error "expected main clause")))
               (generate-bindings (bindings body)
                 (when it-sym
                   (setq body `(let ((,it-sym nil))
                                 ,body)))
                 (when first-sym
                   (setq body `(let ((,first-sym t))
                                 ,body)))
                 (if bindings
                     `(,@(car bindings)
                       ,(generate-bindings (cdr bindings) body))
                     (cond
                       (list-return
                        `(let* ((,(car list-return) (list nil))
                                (,(cdr list-return) ,(car list-return)))
                           ,body))
                       (sum-return
                        `(let ((,sum-return 0))
                           ,body))
                       (minmax-return
                        `(let ((,(car minmax-return) 0)
                               (,(cdr minmax-retun) nil))
                           ,body))
                       (t body)))))
        (do () ((null forms))
          (parse-main-clause-strict))
        `(block ,name
           ,(generate-bindings
             bindings
             `(tagbody
                 ,@prologue
               loop-begin
                 ,@termination-tests
                 (progn ,@body)
                 ,@updates
                 ,@(when first-sym
                     `((setq ,first-sym nil)))
                 (go loop-begin)
               loop-end
                 ,@epilogue
                 ,@(cond
                     (list-return
                      `((return-from ,name (cdr ,(car list-return)))))
                     (sum-return
                      `((return-from ,name ,sum-return)))
                     (minmax-return
                      `((return-from ,name ,(car minmax-return))))
                     (bool-return
                      `((return-from ,name ,(car bool-return))))))))))))

(defmacro loop (&rest forms)
  (let ((all-compound-p t))
    (dolist (form forms all-compound-p)
      (unless (consp form)
        (setq all-compound-p nil)))
    (if all-compound-p
        `(simple-loop ,@forms)
        `(extended-loop ,@forms))))

(defmacro do-plist (vars &body body)
  (let ((key (car vars))
        (value (cadr vars))
        (plist (caddr vars))
        (default (cadddr vars))
        (tail (make-symbol "TAIL")))
    `(do ((,tail ,plist (cddr ,tail)))
         ((null ,tail) ,default)
       (unless (cdr ,tail)
         (error "malformed property list ~s" ',plist))
       (let ((,key (car ,tail))
             (,value (cadr ,tail)))
         (declare (ignorable ,key ,value))
         ,@body))))

(macrolet ((iter-plist (match default)
             `(loop with cdr
                    with tail = plist
                    while tail
                    do (unless (and (consp tail)
                                    (consp (setq cdr (cdr tail))))
                         (error "malformed property list ~s" plist))
                       (let ((key (car tail)))
                         (symbol-macrolet ((value (car cdr)))
                           ,match))
                       (setq tail (cdr cdr))
                    finally (return ,default))))

  (defun getf (plist indicator &optional default)
    (iter-plist (when (eql key indicator)
                  (return value))
                default))

  (defun get-properties (plist indicator-list)
    (iter-plist (when (member key indicator-list)
                  (return (values key value tail)))
                (values nil nil nil)))

  (defun %putf (plist indicator new)
    (iter-plist (when (eql key indicator)
                  (setq value new)
                  (return plist))
                (list* indicator new plist)))

  (defun %remf (plist indicator)
    (let (last-cdr)
      (iter-plist (if (eql key indicator)
                      (progn
                        (if last-cdr
                            (rplacd last-cdr (cdr cdr))
                            (setq plist (cdr cdr)))
                        (return (values plist t)))
                      (setq last-cdr cdr))
                  (values plist nil)))))

(defun list-length (list)
  (loop with n = 0
        do (cond
             ((null list)
              (return n))
             ((consp list)
              (setq list (cdr list)
                    n (+ n 1)))
             (t (error "~s is not a list" list)))))

(unless (fboundp 'length)
  (defun length (obj)
    (cond ((listp obj) (list-length obj))
          ((%simple-vector-p obj) (%simple-vector-length obj))
          (t (error "~s is not a valid sequence" obj)))))

(unless (fboundp 'aref)
  (funcall #'(setf fdefinition) #'%simple-vector-aref 'aref)
  (funcall #'(setf fdefinition) #'(setf %simple-vector-aref) '(setf aref)))

(defun every (predicate &rest sequences)
  (error "unimplemented"))

(defmacro apply-key (elem)
  `(if key (funcall key ,elem) ,elem))

(defun list-find (item list)
  (loop for elem in list
        and i from 0
        when (eql item elem)
          do (return i)))
