(defstruct (hash-table (:constructor %make-hash-table))
  (count 0 :type (integer 0 *))
  (data nil :type (simple-vector t *))
  (test nil :type (member eq eql equal equalp) :read-only t)
  (test-func nil :type function :read-only t)
  (hash-func nil :type function :read-only t)
  (rehash-size nil :type (or (integer 1 *) (float (1.0) *)) :read-only t)
  (rehash-threshold nil :type (real 0 1) :read-only t))

(defun hash-table-size (hash-table)
  (length (hash-table-data hash-table)))

(defun make-hash-table (&key (test 'eql) (size 8) (rehash-size 1.5) (rehash-threshold 1.0) &aux test-func hash-func)
  (setf (values test test-func hash-func)
        (cond ((or (eql test 'eq) (eql test #'eq)) (values 'eq #'eq #'%eq-hash))
              ((or (eql test 'eql) (eql test #'eql)) (values 'eql #'eql #'%eql-hash))
              ((or (eql test 'equal) (eql test #'equal)) (values 'equal #'equal #'%equal-hash))
              ((or (eql test 'equalp) (eql test #'equalp)) (values 'equalp #'equalp #'%equalp-hash))
              (t (error "~s is not a valid test for hash tables." test))))
  (%make-hash-table :data (make-array (list size) :initial-element nil)
                    :test test :test-func test-func :hash-func hash-func
                    :rehash-size rehash-size :rehash-threshold rehash-threshold))

(defun maybe-rehash (hash-table)
  (let ((size (hash-table-size hash-table)))
    (when (<= (hash-table-rehash-threshold hash-table)
              (/ (hash-table-count hash-table) size))
      (let* ((new-size (* size (hash-table-rehash-size hash-table)))
             (old-data (hash-table-data hash-table)))
        (setf (hash-table-count hash-table) 0
              (hash-table-data hash-table) (make-array (list new-size) :initial-element nil))
        (loop for bucket across old-data
              do (loop for (key . value) in bucket
                       do (setf (gethash key hash-table) value)))))))

(defun gethash (key hash-table &optional default)
  (let ((test (hash-table-test-func hash-table))
        (hash-func (hash-table-hash-func hash-table))
        (data (hash-table-data hash-table)))
    (loop for (possible-key . value) in (svref data (mod (funcall hash-func key) (length data)))
          when (funcall test key possible-key)
            do (return (values value t))
          finally (return (values default nil)))))

(defun (setf gethash) (new key hash-table &optional default)
  (declare (ignore default))
  (let ((test (hash-table-test-func hash-table))
        (hash-func (hash-table-hash-func hash-table))
        (data (hash-table-data hash-table)))
    (prog1
        (loop with hash = (mod (funcall hash-func key) (length data))
              for pair in (svref data hash)
              when (funcall test key (car pair))
                do (setf (cdr pair) new)
                   (incf (hash-table-count hash-table))
                   (return new)
              finally (push (cons key new) (svref data hash)))
      (maybe-rehash hash-table))))

(defun remhash (key hash-table)
  (let ((test (hash-table-test-func hash-table))
        (hash-func (hash-table-hash-func hash-table))
        (data (hash-table-data hash-table)))
    (loop with hash = (mod (funcall hash-func key) (length data))
          with bucket = (svref data hash)
          initially (when (funcall test key (caar bucket))
                      (setf (svref data hash) (cdr bucket))
                      (decf (hash-table-count hash-table))
                      (return t))
          for head on bucket
          when (funcall test key (caadr head))
            do (setf (cdr head) (cddr head))
               (decf (hash-table-count hash-table))
               (return t)
          finally (return nil))))

(defun maphash (function hash-table)
  (let ((test (hash-table-test-func hash-table))
        (hash-func (hash-table-hash-func hash-table)))
    (loop for bucket across (hash-table-data hash-table)
          do (loop for (key . value) in bucket
                   do (funcall function key value)))))

(defmacro with-hash-table-iterator ((name hash-table) &body body)
  (let ((hash-table-sym (make-symbol "HASH-TABLE"))
        (data (make-symbol "DATA"))
        (length (make-symbol "LENGTH"))
        (i (make-symbol "I"))
        (l (make-symbol "L"))
        (iter (make-symbol "ITER")))
    `(let* ((,hash-table-sym ,hash-table)
            (,data (hash-table-data ,hash-table-sym))
            (,i -1)
            ,l)
       (flet ((,iter ()
                (loop until ,l
                      do (unless (< (incf ,i) ,length)
                           (return-from ,iter (values nil nil nil))))
                (let ((tmp (pop ,l)))
                  (values t (car tmp) (cdr tmp)))))
         ;; CL spec requires NAME to be bound using MACROLET
         (macrolet ((,name ()
                      (,iter)))
           ,@body)))))

(defun clrhash (hash-table)
  (setf (hash-table-count hash-table) 0)
  (loop with data = (hash-table-data hash-table)
        for i below (length data)
        do (setf (svref data i) nil))
  hash-table)

(setf (fdefinition 'sxhash) #'%equal-hash)
