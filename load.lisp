(in-package "CL-USER")


(require :sb-posix)

(with-compilation-unit ()
    (load "package.lisp"))

(defun lisp-load (file)
  (format t ";; Loading ~s~%" file)
  (finish-output)
  (load file))

(defun fractl-load (file)
  (format t ";; Loading ~s~%" file)
  (finish-output)
  (funcall 'ftx:fractl-load file))

(with-compilation-unit ()
  (lisp-load "fcl/base.lisp")
  (lisp-load "fcl/lambda-list.lisp")
  (lisp-load "fcl/utils.lisp")
  (lisp-load "ftx/text.lisp")
  (lisp-load "ftx/compile.lisp")
  (let ((*features* (remove :evmi *features*)))
    (lisp-load "ftx/run.lisp"))
  (let ((*features* (list* :evmi *features*)))
    (lisp-load "ftx/run.lisp"))
  (lisp-load "ftx/phi.lisp")
  (lisp-load "ftx/gamma.lisp")
  (lisp-load "ftx/lambda.lisp"))

(with-compilation-unit ()
  (sb-alien:load-shared-object "./lib/termio.so")
  (sb-alien:load-shared-object "./lib/shell.so")
  (fractl-load "fsh/psi.fr")
  (lisp-load "fsh/shell.lisp")
  
  (fractl-load "fed/header.fr")
  (lisp-load "fed/termio.lisp")
  (lisp-load "fed/editor.lisp")
  (lisp-load "fed/keys.lisp")
  (lisp-load "fed/cursor.lisp")
  (lisp-load "fed/buffer.lisp")
  (lisp-load "fed/window.lisp")
  (lisp-load "fed/frame.lisp")
  (lisp-load "fed/render.lisp")
  (lisp-load "fed/insert.lisp")
  (funcall 'fed:load-digraphs-file "fed/digraphs.txt")
  (lisp-load "fed/minibuffer.lisp")
  (lisp-load "fed/register.lisp")
  (lisp-load "fed/point.lisp")
  (lisp-load "fed/move.lisp")
  (lisp-load "fed/edit.lisp")
  (lisp-load "fed/undo.lisp")
  (lisp-load "fed/search.lisp")
  (lisp-load "fed/syntax.lisp")
  (lisp-load "fed/bindings.lisp")
  (lisp-load "fed/repl.lisp")
  (lisp-load "fed/modes/fsh.lisp")
  (lisp-load "fed/modes/fcl.lisp")
  (lisp-load "fed/modes/fr.lisp"))
